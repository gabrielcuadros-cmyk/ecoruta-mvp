# Cadena de conexión de PostgreSQL (Neon). En Vercel la crea la integración de Neon.
# Si se deja vacía, en local se usa una base PGlite embebida en ./.pglite
DATABASE_URL="postgresql://usuario:clave@host/neondb?sslmode=require"
# Opcional: secreto para firmar la sesión. Si no se define, se deriva de DATABASE_URL.
AUTH_SECRET=""
